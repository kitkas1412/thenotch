<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime: allow Apple Events to Spotify/Music (Now Playing). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Load the embedded Sparkle.framework. Library validation only accepts
	     libraries signed by Apple or with the app's Team ID, and an ad-hoc
	     signature has no Team ID. Remove this once releases are signed with
	     a Developer ID (the app and Sparkle then share a Team ID). -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
